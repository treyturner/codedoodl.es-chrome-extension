{
  "name": "codedoodl.es-chrome-extension",
  "description": "new tab chrome extension to showcase code doodles",
  "version": "0.1.0",
  "homepage": "https://github.com/treyturner/codedoodl.es-chrome-extension",
  "author": {
    "name": "Neil Carpenter <neilanthonycarpenter@gmail.com> (http://neilcarpenter.com/)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treyturner/codedoodl.es-chrome-extension.git"
  },
  "bugs": {
    "url": "https://github.com/treyturner/codedoodl.es-chrome-extension/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "coffeescript": "2.7.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright": "1.63.0",
    "sass": "1.105.0",
    "xml2js": "0.6.2"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "npm run package && node --test tests/*.test.mjs",
    "test:live": "npm run build && LIVE_TEST=1 node --test tests/extension.test.mjs"
  },
  "dependencies": {
    "backbone": "1.6.1",
    "jquery": "4.0.0",
    "underscore": "1.13.8"
  }
}
